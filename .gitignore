# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local scans, screenshots, recordings, exports and verification output.
/artifacts/
*.log

# Publish the active labelled model, not earlier exports of the scan.
/public/models/*.glb
!/public/models/heart-024522f87aa6dbb0.glb
/public/models/*.inventory.json

# Report documents and generated audit output are not application source.
/docs/**/*.docx
/docs/**/*.pdf
/docs/**/*.html
/docs/**/*.png
/docs/**/*.jpg
/docs/**/*.json
!/docs/rag/anatomy_RAG_minimal_reference_register.json

# Credentials stay local; the empty setup template is intentionally public.
!.env.example
