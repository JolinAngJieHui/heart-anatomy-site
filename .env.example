# Local development: real approved excerpts, no model generation or paid calls.
TUTOR_MODE=review
TUTOR_REVIEW_BACKEND=local
# Server only. Never use NEXT_PUBLIC_ for any of these values.
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-6.1-sol
OPENAI_NAVIGATION_MODEL=gpt-6-luna
# Explicit permission gates. A key alone cannot enable live generation.
TUTOR_LIVE_ENABLED=false
LESSON_REVIEW_LIVE_ENABLED=false
QUIZ_LIVE_ENABLED=false
# Local retrieval; no database, vector store, upload or embeddings required.
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=3500
TUTOR_TIMEOUT_MS=60000
TUTOR_MAX_OUTPUT_TOKENS=1600
TUTOR_REQUESTS_PER_MINUTE=10
TUTOR_DAILY_REQUEST_LIMIT=100
# Existing shared atomic usage limiter, required only for production live mode.
# Reuse the hosting team's configured limiter. No new service was installed.
TUTOR_REDIS_REST_URL=
TUTOR_REDIS_REST_TOKEN=
# Server-only examiner deployment opt-in. Exact true bypasses application usage
# caps/shared-store requirements, not live AI, request validation or provider limits.
# Omit/set false and configure Redis to restore normal production limiting.
ASSESSMENT_DISABLE_USAGE_LIMITS=false
# Legacy ingestion / optional remote review tools only; not used by live tutor.
OPENAI_MODEL=
OPENAI_VECTOR_STORE_ID=

# Generation plus a separate evidence audit (milliseconds); no automatic retries.
LEARNING_GENERATION_TIMEOUT_MS=60000
